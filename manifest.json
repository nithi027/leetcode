{
  "manifest_version": 3,
  "name": "nikice - LeetCode Auto-Solver",
  "version": "2.0.0",
  "description": "Automated LeetCode Problem Solver, Auto-Submitter & Sequential Navigator - powered by zeroes",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "https://xtension-46aea-default-rtdb.firebaseio.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "nikice - LeetCode Auto-Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
